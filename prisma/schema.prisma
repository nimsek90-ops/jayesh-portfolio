// Prisma schema for Jayesh Nimse Portfolio & Admin System
// Configured for MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN") // SUPER_ADMIN, ADMIN, EDITOR
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

model ProjectCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  order       Int       @default(0)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Project {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  summary     String          @db.Text
  problem     String?         @db.Text
  solution    String?         @db.Text
  techStack   String          @db.Text // Comma-separated or JSON string
  screenshots String?         @db.Text // JSON string array of URLs
  categoryId  String
  category    ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  githubUrl   String?
  liveUrl     String?
  featured    Boolean         @default(false)
  order       Int             @default(0)
  published   Boolean         @default(true)
  caseStudy   String?         @db.LongText
  views       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([featured])
}

model SkillCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level      String        @default("Advanced") // Editable description, e.g. "Proficient", "Advanced", "Expert"
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId])
}

model Experience {
  id             String    @id @default(cuid())
  role           String
  company        String
  location       String?
  employmentType String?   @default("Full-time") // Founder, Intern, Full-time
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  description    String    @db.Text
  highlights     String?   @db.Text // JSON string array of bullets
  order          Int       @default(0)
  published      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Education {
  id           String    @id @default(cuid())
  degree       String
  institution  String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  grade        String?
  description  String?   @db.Text
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  issuer      String?
  year        Int?
  category    String   @default("National") // Martial Arts, Defense Exam, Academic, Tech
  description String   @db.Text
  badgeUrl    String?
  verified    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certification {
  id            String    @id @default(cuid())
  title         String
  organization  String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Service {
  id           String   @id @default(cuid())
  title        String
  shortDesc    String   @db.Text
  fullDesc     String?  @db.Text
  icon         String?
  deliverables String?  @db.Text // JSON string array
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  authorRole String
  company    String?
  avatarUrl  String?
  content    String   @db.Text
  rating     Int      @default(5)
  verified   Boolean  @default(true)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String    @db.Text
  content     String    @db.LongText
  coverImage  String?
  tags        String?   // JSON array or comma separated
  readingTime String?   @default("5 min read")
  published   Boolean   @default(true)
  views       Int       @default(0)
  publishedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published])
}

model ContactMessage {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  subject         String
  message         String   @db.Text
  serviceInterest String?
  isRead          Boolean  @default(false)
  isSpam          Boolean  @default(false)
  ipAddress       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique // linkedin, github, instagram, twitter, etc.
  url       String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model ResumeFile {
  id            String   @id @default(cuid())
  title         String
  fileUrl       String
  version       String   @default("1.0")
  isPrimary     Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String   // page_view, project_view, contact_submit, resume_download
  path      String?
  referrer  String?
  userAgent String?
  ipHash    String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model Comment {
  id         String    @id @default(cuid())
  name       String
  email      String
  content    String    @db.Text
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  ipAddress  String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

